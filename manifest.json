{
  "manifest_version": 3,
  "name": "Funding Radar Links",
  "version": "1.3.0",
  "description": "卡片雷达入口与 Hyperliquid 公共限仓查询，可设置自动查询币种和间隔。",
  "action": {
    "default_title": "Funding Radar Links",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.hyperliquid.xyz/*"
  ]
}
