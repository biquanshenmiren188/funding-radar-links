{
  "manifest_version": 3,
  "name": "Funding Radar Links",
  "version": "1.2.0",
  "description": "在套利卡片的标的旁打开对应的资金费雷达。",
  "action": {
    "default_title": "Funding Radar Links",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  }
}
