{
  "manifest_version": 3,
  "name": "Funding Radar Links",
  "version": "1.8.7",
  "description": "卡片探入口、合约结算费率估算与公共限仓查询，支持自动查询和指定币种。",
  "action": {
    "default_title": "Funding Radar Links",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.hyperliquid.xyz/*",
    "https://fapi.binance.com/*",
    "https://fapi.asterdex.com/*",
    "https://api.bybit.com/*",
    "https://api.bitget.com/*",
    "https://api.gateio.ws/*",
    "https://www.okx.com/*"
  ]
}
